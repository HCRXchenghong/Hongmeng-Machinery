{
  "name": "hongmeng-machinery-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "admin-web"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "3.1115.0",
    "@aws-sdk/s3-request-presigner": "3.1115.0",
    "bcryptjs": "2.4.3",
    "formidable": "2.1.5",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "sharp": "0.35.3",
    "typescript": "6.0.3"
  },
  "scripts": {
    "verify": "bash scripts/verify-all.sh",
    "build": "npm run build:frontend",
    "build:admin-web": "npm --workspace admin-web run build",
    "build:frontend": "npm --workspace frontend run build",
    "check": "npm run typecheck && npm run lint && npm run cms:contract && npm run check:i18n",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "check:locale": "node scripts/check-locale-first-paint.mjs",
    "cms:contract": "node scripts/check-cms-content-contract.mjs",
    "cms:cutover": "node admin-server/scripts/cutover-legacy-storage.mjs",
    "cms:migrate-external-media": "node admin-server/scripts/migrate-external-media.mjs",
    "dev:admin": "node admin-server/server.mjs",
    "dev:admin-web": "npm --workspace admin-web run dev",
    "dev:backend": "npm run dev:admin",
    "dev:cms": "npm run dev:admin",
    "dev:frontend": "npm --workspace frontend run dev",
    "format": "npm --workspace frontend run format",
    "lint": "npm --workspace frontend run lint",
    "postinstall": "node scripts/ensure-rolldown-binding.mjs",
    "preview:frontend": "npm --workspace frontend run preview",
    "rebuild:webhook": "node scripts/rebuild-webhook.mjs",
    "servicebridge:backend": "cd servicebridge/backend && go run ./cmd/server",
    "servicebridge:web": "cd servicebridge/apps/user-web && python3 -m http.server ${SERVICEBRIDGE_USER_WEB_PORT:-5175}",
    "test:admin": "node --test admin-server/**/*.test.mjs",
    "typecheck": "npm --workspace frontend run typecheck",
    "verify:ai-failover": "node scripts/verify-ai-failover.mjs",
    "verify:ai-persistence": "node scripts/verify-ai-persistence.mjs",
    "verify:console": "node scripts/verify-console-pages.mjs",
    "verify:clicks": "node scripts/verify-click-flows.mjs",
    "verify:clicks:admin": "node scripts/verify-click-admin.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.62.1"
  }
}
