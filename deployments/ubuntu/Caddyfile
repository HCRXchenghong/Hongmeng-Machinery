# 宏盟机械站点入口：Caddy 直接监听 80/443，自动申请并续期证书。
# 域名与证书邮箱全部来自容器环境变量（SITE_DOMAIN / ADMIN_DOMAIN / SERVICE_DOMAIN / ACME_EMAIL），
# 由 deployments/ubuntu/.env.ubuntu 提供，避免仓库里写死域名或重复生成配置导致漂移。
{
	email {$ACME_EMAIL}
	admin off
}

# 官网
{$SITE_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "SAMEORIGIN"
		# Astro/React 的 hydration 脚本是内联的，没有 nonce，所以 script 必须允许 unsafe-inline；
		# 其余指令按实际用到的资源收紧（图片/视频允许 https、iframe 只放客服与视频站）。
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https://{$ADMIN_DOMAIN} https://{$SERVICE_DOMAIN}; frame-src 'self' https://{$SERVICE_DOMAIN} https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
	}

	# 咨询单由官网域名直连后台，避免跨域与预检。
	handle /site-admin-api/leads {
		reverse_proxy admin-server:1337
	}

	# 商品记录保存在数据库，由后台公开端点按当前已上架商品生成多语言站点地图。
	handle /sitemap-products.xml {
		rewrite * /site-admin-api/shop/sitemap-products.xml
		reverse_proxy admin-server:1337
	}

	# 草稿预览：构建服务写入发布卷的 preview/ 目录，由官网容器暴露。
	handle /__preview/* {
		reverse_proxy frontend:80
	}

	handle {
		reverse_proxy frontend:80
	}
}

# 统一后台
{$ADMIN_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# 内置对象存储的 S3 网关：路径风格、bucket 名固定。
	# 不剥离前缀，SigV4 按原路径校验，bucket 名必须与 S3_BUCKET 一致。
	handle /hongmeng-site-media* {
		reverse_proxy s3:8333
	}

	reverse_proxy admin-server:1337
}

# 客服引擎 + 访客端 + 开放接口
{$SERVICE_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	handle /api/* {
		reverse_proxy servicebridge-backend-1:8080 servicebridge-backend-2:8080
	}

	handle /api {
		reverse_proxy servicebridge-backend-1:8080 servicebridge-backend-2:8080
	}

	handle /ws* {
		reverse_proxy servicebridge-backend-1:8080 servicebridge-backend-2:8080
	}

	# 第三方平台开放接口（API Key 鉴权），必须与访客端页面区分开。
	handle /open/* {
		reverse_proxy servicebridge-backend-1:8080 servicebridge-backend-2:8080
	}

	handle /open {
		reverse_proxy servicebridge-backend-1:8080 servicebridge-backend-2:8080
	}

	handle /uploads/* {
		reverse_proxy servicebridge-backend-1:8080 servicebridge-backend-2:8080
	}

	handle /readyz {
		reverse_proxy servicebridge-backend-1:8080 servicebridge-backend-2:8080
	}

	handle /healthz {
		reverse_proxy servicebridge-backend-1:8080 servicebridge-backend-2:8080
	}

	handle /metrics {
		reverse_proxy servicebridge-backend-1:8080 servicebridge-backend-2:8080
	}

	handle {
		reverse_proxy servicebridge-user-web:80
	}
}
