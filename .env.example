PUBLIC_SITE_URL=http://127.0.0.1:4331
FRONTEND_PORT=4331
PUBLIC_ADMIN_URL=http://127.0.0.1:1338
PORT=1338
PUBLIC_LEADS_ENDPOINT=http://127.0.0.1:1338/site-admin-api/leads
ADMIN_CORS_ALLOWED_ORIGINS=http://127.0.0.1:4331,http://localhost:4331,http://localhost:1338
PUBLIC_SERVICEBRIDGE_URL=http://127.0.0.1:5175
PUBLIC_SERVICEBRIDGE_API_URL=http://127.0.0.1:8081
GEOIP_UPLOAD_DIR=geoip
SERVICEBRIDGE_API_URL=http://127.0.0.1:8081
SERVICEBRIDGE_USER_WEB_PORT=5175
HTTP_ADDR=0.0.0.0:8081
SERVICEBRIDGE_ADMIN_ACCOUNT=superadmin
SERVICEBRIDGE_ADMIN_PASSWORD=123456
REBUILD_WEBHOOK_SECRET=change-me-webhook-secret
DATABASE_URL=postgres://hongmeng_cms:change-me-local-postgres-password@127.0.0.1:55435/hongmeng_cms?sslmode=disable
POSTGRES_HOST_PORT=55435
CMS_STORE_DRIVER=postgres
CMS_DATA_ENCRYPTION_KEY=change-me-at-least-32-random-characters
# ===== Go 客服引擎（servicebridge backend）持久化 =====
# 引擎的 AI 供应商、能力绑定、故障转移候选链、知识库、会话/消息都存 PostgreSQL。
# 这里必须是 postgres；写成 memory 时重启即丢（本地栈脚本会强制为 postgres）。
STORE_DRIVER=postgres
# 引擎自己的库，与后台 CMS 分库避免表名冲突。本地栈会自动创建 astreva_engine；
# 不填则由 scripts/run-local-stack.sh 从 DATABASE_URL 换库名推导。
SERVICEBRIDGE_DATABASE_URL=postgres://hongmeng_cms:change-me-local-postgres-password@127.0.0.1:55435/hongmeng_engine?sslmode=disable
# 加密 AI 供应商 API Key 用（库内是密文，接口只回掩码）。≥32 字符；一旦有数据就不要再改，否则旧 Key 无法解密。
DATA_ENCRYPTION_KEY=change-me-at-least-32-random-characters
ADMIN_MEDIA_DRIVER=s3
S3_ENDPOINT=http://127.0.0.1:10016
MINIO_API_PORT=10016
MINIO_CONSOLE_PORT=10017
S3_REGION=us-east-1
S3_BUCKET=hongmeng-site-media
S3_ACCESS_KEY_ID=hongmeng-local
S3_SECRET_ACCESS_KEY=change-me-local-s3-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://127.0.0.1:10016/hongmeng-site-media
ADMIN_S3_KEY_PREFIX=site-admin
ADMIN_UPLOAD_MAX_BYTES=209715200
ADMIN_IMAGE_VARIANT_WIDTHS=400,800,1200,1600
ADMIN_IMAGE_WEBP_QUALITY=82
ADMIN_IMAGE_MAX_PIXELS=80000000
# OpenAI Images API；留空时后台会明确标记 AI 生图不可用，不影响 R2 素材功能
ADMIN_OPENAI_IMAGE_API_KEY=
ADMIN_OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
ADMIN_OPENAI_IMAGE_MODEL=gpt-image-1
ADMIN_AI_IMAGE_MODELS=gpt-image-1,dall-e-3,dall-e-2
ADMIN_AI_ALLOWED_HOSTS=api.openai.com
ADMIN_AI_IMAGE_DOWNLOAD_HOSTS=api.openai.com,oaidalleapiprodscus.blob.core.windows.net
SERVICEBRIDGE_CORS_ALLOWED_ORIGINS=http://127.0.0.1:4331,http://127.0.0.1:5175,http://localhost:4331,http://localhost:5175
FRONTEND_REBUILD_WEBHOOK_URL=http://127.0.0.1:8788/rebuild
REBUILD_WEBHOOK_PORT=8788
# 推送（Firebase/APNs）现在在统一后台「系统设置 → 推送设置」里配置并加密入库。
# 下面两个变量只是可选的启动引导值：数据库里没有推送配置时用它兜底，生产建议留空。
FCM_ACCESS_TOKEN=
FCM_ENDPOINT=
APP_RELEASE_MAX_BYTES=209715200

# 客服引擎内部接口令牌（admin-server 用它把官网埋点转发到访客画像；未配置则跳过转发）。
# 生产环境请使用 32 位以上随机值，并同时配置到 servicebridge 后端的同名环境变量。
INTERNAL_API_TOKEN=change-me-internal-api-token

# 邮件发送（注册验证码、验证码邮件必填）。也可在统一后台「系统设置 → 邮件发送」里配置并加密入库，
# 数据库里已有配置时以后台为准；下面只是启动引导值。
ADMIN_SMTP_HOST=
ADMIN_SMTP_PORT=587
ADMIN_SMTP_SECURE=false
ADMIN_SMTP_USER=
ADMIN_SMTP_PASS=
ADMIN_SMTP_FROM=
ADMIN_SMTP_FROM_NAME=

# 前置代理时才开：真实客户端 IP 从 X-Forwarded-For 的最右边（代理追加的那一跳）取，
# 代理必须覆盖写入该头。多级代理时把深度调到与实际层数一致。
ADMIN_TRUST_PROXY=false
ADMIN_TRUST_PROXY_DEPTH=1

# 下单同意 Cookie 的签名密钥（留空则退回 2FA 密钥 / 数据加密密钥）。轮换后已发出的同意凭据全部失效。
ADMIN_ANALYTICS_CONSENT_SECRET=
# 生产环境默认给会话与同意 Cookie 加 Secure；本地 http 想强制关掉时设为 false。
SESSION_COOKIE_SECURE=
