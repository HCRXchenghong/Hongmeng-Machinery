---
import StoreLayout from '../../../layouts/StoreLayout.astro';
import { loadSeoProducts } from '../../../lib/product-seo';
import { loadProductDetail } from '../../../lib/storefront-bootstrap';

export async function getStaticPaths() {
  const products = await loadSeoProducts('en');
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const detail = await loadProductDetail('en', product.slug);
---
<StoreLayout initialDetail={detail} mode="product" title={product.name} description={product.summary} product={product} />
